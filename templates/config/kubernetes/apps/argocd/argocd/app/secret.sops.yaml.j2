---
apiVersion: v1
kind: Secret
metadata:
  name: argocd-repo-credentials
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repository
type: Opaque
stringData:
  type: git
  url: "#{ repository_url }#"
  sshPrivateKey: |
    # SOPS_ENCRYPTED_VALUE: Deploy key for Git repository access
    # Generate with: ssh-keygen -t ed25519 -C "argocd@cluster" -f argocd-deploy-key
    # Add public key to your Gitea repository: Settings -> Deploy Keys
    ENC[AES256_GCM,data:...,tag:...,type:str]
