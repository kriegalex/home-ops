---
apiVersion: v1
kind: Secret
metadata:
  name: infomaniak-credentials
  namespace: cert-manager
type: Opaque
stringData:
  api-token: |
    # SOPS_ENCRYPTED_VALUE: Infomaniak API token for DNS management
    # Create at: https://manager.infomaniak.com/v3/infomaniak-api
    # Required scopes: domain:read, dns:read, dns:write
    # Replace this placeholder with your encrypted token using sops
    ENC[AES256_GCM,data:...,tag:...,type:str]
