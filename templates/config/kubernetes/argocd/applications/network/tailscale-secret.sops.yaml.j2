#% if tailscale_enabled | default(false, true) %#
---
apiVersion: v1
kind: Secret
metadata:
  name: tailscale-operator-oauth
  namespace: tailscale
type: Opaque
stringData:
  client_id: |
    # SOPS_ENCRYPTED_VALUE: Tailscale OAuth Client ID
    # Create at: https://login.tailscale.com/admin/settings/oauth
    # Replace this placeholder with your encrypted client ID using sops
    ENC[AES256_GCM,data:...,tag:...,type:str]
  client_secret: |
    # SOPS_ENCRYPTED_VALUE: Tailscale OAuth Client Secret
    # Create at: https://login.tailscale.com/admin/settings/oauth
    # Replace this placeholder with your encrypted client secret using sops
    ENC[AES256_GCM,data:...,tag:...,type:str]
#% endif %#
